# Compile-only profile; it does not provision any key or authorize flashing.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_NONE=y
CONFIG_RECORDER_NVS_HMAC_EXISTING=y
CONFIG_RECORDER_NVS_HMAC_KEY_ID=0
# CONFIG_RECORDER_DEVELOPMENT_CREDENTIAL_RISK is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set
# CONFIG_SECURE_BOOT is not set
